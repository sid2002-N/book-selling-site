// KRM.lib database schema — see docs/DATABASE.md.
// Conventions: snake_case singular tables (@@map), snake_case columns (@map), UUIDv7 ids,
// money as integer minor units + ISO-4217 currency, timestamps in UTC.
// Rules Prisma cannot express (CHECK constraints, sequences, full-text search) live in
// hand-written SQL migrations and are documented in DATABASE.md §5.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  active
  locked
  blocked
  deleted
}

enum AuthProvider {
  credentials
  google
}

enum TokenPurpose {
  email_verify
  password_reset
  email_change
  gift_claim
}

enum ActorType {
  admin
  system
  customer
}

enum ProductType {
  book
  guide
  workbook
  bundle
  free_resource
}

enum ProductStatus {
  draft
  in_review
  published
  unpublished
  archived
}

enum OwnerType {
  house
  creator
}

enum VersionStatus {
  draft
  published
  superseded
}

enum FileKind {
  pdf
  fillable_pdf
  external_link
  zip
}

enum PreviewKind {
  cover
  sample_page
  chapter_example
  checklist_example
}

enum AssetBucket {
  public
  private
}

enum AssetKind {
  image
  pdf
  doc
}

enum ContentStatus {
  draft
  scheduled
  published
  archived
}

enum CurrencyCode {
  INR
  USD
}

enum OrderStatus {
  pending_payment
  payment_pending
  paid
  failed
  cancelled
  refunded
  partially_refunded
  disputed
}

enum PaymentProvider {
  razorpay
  stripe
}

enum PaymentStatus {
  created
  processing
  requires_action
  pending_verification
  succeeded
  failed
  cancelled
  refunded
  partially_refunded
  disputed
}

enum TransactionType {
  charge
  refund
  dispute
  adjustment
  fee
}

enum WebhookStatus {
  received
  processed
  failed
  ignored
}

enum RefundStatus {
  requested
  approved
  processing
  completed
  rejected
  failed
}

enum CouponType {
  percent
  fixed
}

enum LibrarySource {
  purchase
  gift
  free
  admin_grant
}

enum DownloadStatus {
  issued
  completed
  failed
  denied
}

enum ReviewStatus {
  pending
  approved
  rejected
  reported
}

enum SubscriberStatus {
  pending
  subscribed
  unsubscribed
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  email            String     @unique @db.Citext
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  name             String
  avatarUrl        String?    @map("avatar_url")
  phone            String?
  country          String?    @db.Char(2)
  locale           String     @default("en")
  status           UserStatus @default(active)
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  referralCode     String?    @unique @map("referral_code")
  referredByUserId String?    @map("referred_by_user_id") @db.Uuid
  bio              String?
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)

  referredBy         User?               @relation("Referral", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals          User[]              @relation("Referral")
  accounts           Account[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  twoFactor          TwoFactor?
  recoveryCodes      RecoveryCode[]
  trustedDevices     TrustedDevice[]
  addresses          Address[]
  adminUser          AdminUser?
  carts              Cart[]
  orders             Order[]
  libraryItems       LibraryItem[]
  downloadEvents     DownloadEvent[]
  wishlistItems      WishlistItem[]
  recentlyViewed     RecentlyViewed[]
  reviews            Review[]
  notifications      Notification[]
  refundsRequested   Refund[]            @relation("RefundRequester")
  auditLogs          AuditLog[]

  @@map("user")
}

model Account {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  passwordHash      String?      @map("password_hash")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash         String    @unique @map("token_hash")
  ip                String?
  userAgent         String?   @map("user_agent")
  deviceLabel       String?   @map("device_label")
  /// True once the second factor has been satisfied for this session.
  twoFactorPassed   Boolean   @default(false) @map("two_factor_passed")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model VerificationToken {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  identifier String
  tokenHash  String       @unique @map("token_hash")
  purpose    TokenPurpose
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
  @@map("verification_token")
}

model TwoFactor {
  userId          String    @id @map("user_id") @db.Uuid
  /// AES-256-GCM encrypted TOTP secret (lib/crypto).
  secretEncrypted String    @map("secret_encrypted")
  enabledAt       DateTime? @map("enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time-step, for replay protection.
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_code")
}

model TrustedDevice {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_device")
}

model LoginAttempt {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  userId     String?  @map("user_id") @db.Uuid
  ip         String?
  success    Boolean
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifier, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempt")
}

model Address {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  fullName         String   @map("full_name")
  line1            String
  line2            String?
  city             String
  state            String?
  postalCode       String?  @map("postal_code")
  country          String   @db.Char(2)
  isDefaultBilling Boolean  @default(false) @map("is_default_billing")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("address")
}

// ───────────────────────────── Admin & RBAC ─────────────────────────────

model AdminUser {
  userId           String    @id @map("user_id") @db.Uuid
  status           String    @default("active")
  require2fa       Boolean   @default(true) @map("require_2fa")
  lastAdminLoginAt DateTime? @map("last_admin_login_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles AdminUserRole[]

  @@map("admin_user")
}

model AdminRole {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       AdminUserRole[]

  @@map("admin_role")
}

model Permission {
  key         String @id
  description String

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permission")
}

model AdminUserRole {
  adminUserId String @map("admin_user_id") @db.Uuid
  roleId      String @map("role_id") @db.Uuid

  adminUser AdminUser @relation(fields: [adminUserId], references: [userId], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_role")
}

/// Append-only (no updates/deletes from application code).
model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

model SecurityEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  type      String
  severity  String   @default("info")
  userId    String?  @map("user_id") @db.Uuid
  ip        String?
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([type, createdAt])
  @@map("security_event")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Asset {
  id          String      @id @default(uuid(7)) @db.Uuid
  kind        AssetKind
  storageKey  String      @unique @map("storage_key")
  bucket      AssetBucket
  mime        String
  width       Int?
  height      Int?
  alt         String?
  blurDataUrl String?     @map("blur_data_url")
  sizeBytes   Int         @map("size_bytes")
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  productCovers    Product[]        @relation("ProductCover")
  productOgImages  Product[]        @relation("ProductOg")
  previews         ProductPreview[]
  categoryCovers   Category[]
  collectionCovers Collection[]

  @@map("asset")
}

model Product {
  id                String                   @id @default(uuid(7)) @db.Uuid
  type              ProductType
  title             String
  subtitle          String?
  slug              String                   @unique
  shortDescription  String?                  @map("short_description")
  description       String?
  coverAssetId      String?                  @map("cover_asset_id") @db.Uuid
  spineColor        String                   @default("#2F4A3A") @map("spine_color")
  status            ProductStatus            @default(draft)
  publishedAt       DateTime?                @map("published_at") @db.Timestamptz(3)
  primaryCategoryId String?                  @map("primary_category_id") @db.Uuid
  publisher         String?
  language          String                   @default("en")
  level             String?
  licenseId         String?                  @map("license_id") @db.Uuid
  seoTitle          String?                  @map("seo_title")
  seoDescription    String?                  @map("seo_description")
  ogAssetId         String?                  @map("og_asset_id") @db.Uuid
  isFeatured        Boolean                  @default(false) @map("is_featured")
  isBestseller      Boolean                  @default(false) @map("is_bestseller")
  /// The version customers receive now. One current version per product, enforced by uniqueness.
  currentVersionId  String?                  @unique @map("current_version_id") @db.Uuid
  ownerType         OwnerType                @default(house) @map("owner_type")
  ownerId           String?                  @map("owner_id") @db.Uuid
  /// Review aggregates, refreshed from `review` rows by the reviews service (never trusted over source rows).
  ratingAvg         Decimal?                 @map("rating_avg") @db.Decimal(3, 2)
  ratingCount       Int                      @default(0) @map("rating_count")
  /// Maintained by trigger (see migration `catalog_search`).
  searchVector      Unsupported("tsvector")? @map("search_vector")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(3)

  cover             Asset?              @relation("ProductCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  ogImage           Asset?              @relation("ProductOg", fields: [ogAssetId], references: [id], onDelete: SetNull)
  primaryCategory   Category?           @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  license           License?            @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  currentVersion    ProductVersion?     @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions          ProductVersion[]    @relation("ProductVersions")
  previews          ProductPreview[]
  prices            ProductPrice[]
  categories        ProductCategory[]
  tags              ProductTag[]
  authors           ProductAuthor[]
  tocEntries        TocEntry[]
  insideItems       ProductInsideItem[]
  faqs              ProductFaq[]
  bundleItems       BundleItem[]        @relation("BundleParent")
  inBundles         BundleItem[]        @relation("BundleChild")
  collectionItems   CollectionItem[]
  linkedCollections Collection[]        @relation("CollectionBundle")
  cartItems         CartItem[]
  orderItems        OrderItem[]
  libraryItems      LibraryItem[]
  wishlistItems     WishlistItem[]
  recentlyViewed    RecentlyViewed[]
  reviews           Review[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([type, status])
  @@index([primaryCategoryId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_title_trgm_idx")
  @@index([searchVector], type: Gin, map: "product_search_vector_idx")
  @@map("product")
}

model ProductVersion {
  id         String        @id @default(uuid(7)) @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  version    String
  changelog  String?
  status     VersionStatus @default(draft)
  releasedAt DateTime?     @map("released_at") @db.Timestamptz(3)
  pageCount  Int?          @map("page_count")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product        Product         @relation("ProductVersions", fields: [productId], references: [id], onDelete: Restrict)
  currentFor     Product?        @relation("CurrentVersion")
  files          ProductFile[]
  orderItems     OrderItem[]
  libraryItems   LibraryItem[]
  downloadEvents DownloadEvent[]

  @@unique([productId, version])
  @@map("product_version")
}

model ProductFile {
  id                   String   @id @default(uuid(7)) @db.Uuid
  productVersionId     String   @map("product_version_id") @db.Uuid
  kind                 FileKind
  /// Private-bucket key. Never serialised to clients.
  storageKey           String?  @map("storage_key")
  /// Encrypted protected link for external products (e.g. Notion templates).
  externalUrlEncrypted String?  @map("external_url_encrypted")
  fileName             String   @map("file_name")
  sizeBytes            Int      @default(0) @map("size_bytes")
  checksumSha256       String?  @map("checksum_sha256")
  mime                 String
  pageCount            Int?     @map("page_count")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  version ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)

  @@index([productVersionId])
  @@map("product_file")
}

model ProductPreview {
  id               String      @id @default(uuid(7)) @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  kind             PreviewKind
  label            String?
  pageNumber       Int?        @map("page_number")
  assetId          String      @map("asset_id") @db.Uuid
  position         Int         @default(0)
  watermarkApplied Boolean     @default(false) @map("watermark_applied")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([productId, position])
  @@map("product_preview")
}

model ProductPrice {
  id             String       @id @default(uuid(7)) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  currency       CurrencyCode
  amountMinor    Int          @map("amount_minor")
  compareAtMinor Int?         @map("compare_at_minor")
  startsAt       DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?    @map("ends_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, currency])
  @@map("product_price")
}

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  slug           String   @unique
  name           String
  description    String?
  parentId       String?  @map("parent_id") @db.Uuid
  coverAssetId   String?  @map("cover_asset_id") @db.Uuid
  icon           String?
  position       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("CategoryTree")
  cover           Asset?            @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  products        ProductCategory[]
  primaryProducts Product[]         @relation("PrimaryCategory")
  collections     Collection[]

  @@map("category")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
  @@map("product_category")
}

model Tag {
  id   String @id @default(uuid(7)) @db.Uuid
  slug String @unique
  name String

  products ProductTag[]

  @@map("tag")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tag")
}

model Author {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  bio       String?
  avatarUrl String?  @map("avatar_url")
  userId    String?  @map("user_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductAuthor[]

  @@map("author")
}

model ProductAuthor {
  productId String @map("product_id") @db.Uuid
  authorId  String @map("author_id") @db.Uuid
  role      String @default("author")
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  Author  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@id([productId, authorId])
  @@map("product_author")
}

model TocEntry {
  id         String  @id @default(uuid(7)) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  position   Int
  title      String
  pageNumber Int?    @map("page_number")
  parentId   String? @map("parent_id") @db.Uuid

  product  Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent   TocEntry?  @relation("TocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TocEntry[] @relation("TocTree")

  @@index([productId, position])
  @@map("toc_entry")
}

model ProductInsideItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  position    Int
  title       String
  description String?
  icon        String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_inside_item")
}

model ProductFaq {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  position  Int
  question  String
  answer    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_faq")
}

model License {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  name      String
  summary   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  products Product[]

  @@map("license")
}

// ─────────────────── Collections & bundles ───────────────────

/// Editorial grouping (C3). May link to a sellable bundle product.
model Collection {
  id                    String        @id @default(uuid(7)) @db.Uuid
  slug                  String        @unique
  title                 String
  description           String?
  coverAssetId          String?       @map("cover_asset_id") @db.Uuid
  status                ContentStatus @default(draft)
  categoryId            String?       @map("category_id") @db.Uuid
  linkedBundleProductId String?       @map("linked_bundle_product_id") @db.Uuid
  badge                 String?
  isFeatured            Boolean       @default(false) @map("is_featured")
  position              Int           @default(0)
  publishedAt           DateTime?     @map("published_at") @db.Timestamptz(3)
  seoTitle              String?       @map("seo_title")
  seoDescription        String?       @map("seo_description")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(3)

  cover        Asset?           @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  linkedBundle Product?         @relation("CollectionBundle", fields: [linkedBundleProductId], references: [id], onDelete: SetNull)
  items        CollectionItem[]

  @@index([status, position])
  @@map("collection")
}

model CollectionItem {
  collectionId String  @map("collection_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  position     Int     @default(0)
  note         String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_item")
}

/// Bundle savings are derived (sum of item prices − bundle price), never stored.
model BundleItem {
  bundleProductId String @map("bundle_product_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  position        Int    @default(0)

  bundle  Product @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  product Product @relation("BundleChild", fields: [productId], references: [id], onDelete: Restrict)

  @@id([bundleProductId, productId])
  @@map("bundle_item")
}

// ───────────────────────────── Commerce ─────────────────────────────

/// One cart per user (unique user_id); guest carts are keyed by a hashed cookie token.
model Cart {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String?      @unique @map("user_id") @db.Uuid
  guestTokenHash String?      @unique @map("guest_token_hash")
  currency       CurrencyCode @default(INR)
  couponCode     String?      @map("coupon_code")
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("cart")
}

/// No quantity column: digital products are always quantity 1 (C2).
model CartItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  savedForLater Boolean  @default(false) @map("saved_for_later")
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_item")
}

model Order {
  id                 String       @id @default(uuid(7)) @db.Uuid
  /// KRM-###### from `order_number_seq` (see migration).
  orderNumber        String       @unique @default(dbgenerated("('KRM-'::text || lpad((nextval('order_number_seq'::regclass))::text, 6, '0'::text))")) @map("order_number")
  userId             String?      @map("user_id") @db.Uuid
  guestEmail         String?      @map("guest_email") @db.Citext
  /// Hashed token that lets a guest view this order's status and claim their library.
  guestAccessHash    String?      @unique @map("guest_access_hash")
  status             OrderStatus  @default(pending_payment)
  currency           CurrencyCode
  subtotalMinor      Int          @map("subtotal_minor")
  discountMinor      Int          @default(0) @map("discount_minor")
  taxMinor           Int          @default(0) @map("tax_minor")
  totalMinor         Int          @map("total_minor")
  billingName        String?      @map("billing_name")
  billingCountry     String       @map("billing_country") @db.Char(2)
  billingAddress     Json?        @map("billing_address")
  couponCodeSnapshot String?      @map("coupon_code_snapshot")
  couponId           String?      @map("coupon_id") @db.Uuid
  placedAt           DateTime     @default(now()) @map("placed_at") @db.Timestamptz(3)
  paidAt             DateTime?    @map("paid_at") @db.Timestamptz(3)
  cancelledAt        DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  idempotencyKey     String       @unique @map("idempotency_key")
  ip                 String?
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon      Coupon?            @relation(fields: [couponId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payments    Payment[]
  refunds     Refund[]
  invoice     Invoice?
  redemptions CouponRedemption[]

  @@index([userId, placedAt(sort: Desc)])
  @@index([status, placedAt])
  @@map("order")
}

model OrderItem {
  id               String      @id @default(uuid(7)) @db.Uuid
  orderId          String      @map("order_id") @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  productVersionId String?     @map("product_version_id") @db.Uuid
  titleSnapshot    String      @map("title_snapshot")
  typeSnapshot     ProductType @map("type_snapshot")
  unitPriceMinor   Int         @map("unit_price_minor")
  compareAtMinor   Int?        @map("compare_at_minor")
  discountMinor    Int         @default(0) @map("discount_minor")
  taxMinor         Int         @default(0) @map("tax_minor")
  isGift           Boolean     @default(false) @map("is_gift")

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  version      ProductVersion? @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  libraryItems LibraryItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model Payment {
  id                 String          @id @default(uuid(7)) @db.Uuid
  orderId            String          @map("order_id") @db.Uuid
  provider           PaymentProvider
  providerOrderRef   String?         @map("provider_order_ref")
  providerPaymentRef String?         @map("provider_payment_ref")
  status             PaymentStatus   @default(created)
  amountMinor        Int             @map("amount_minor")
  currency           CurrencyCode
  method             String?
  /// Internal only — never shown to customers.
  failureCode        String?         @map("failure_code")
  failureMessage     String?         @map("failure_message")
  verifiedAt         DateTime?       @map("verified_at") @db.Timestamptz(3)
  idempotencyKey     String          @unique @map("idempotency_key")
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]
  refunds      Refund[]
  disputes     Dispute[]

  @@unique([provider, providerOrderRef])
  @@index([status, updatedAt])
  @@index([orderId])
  @@map("payment")
}

model PaymentTransaction {
  id             String          @id @default(uuid(7)) @db.Uuid
  paymentId      String          @map("payment_id") @db.Uuid
  provider       PaymentProvider
  type           TransactionType
  providerTxnRef String          @map("provider_txn_ref")
  amountMinor    Int             @map("amount_minor")
  currency       CurrencyCode
  status         String
  /// Redacted provider payload.
  raw            Json?
  occurredAt     DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTxnRef, type])
  @@map("payment_transaction")
}

/// Idempotency anchor for provider webhooks: unique (provider, event_id).
model WebhookEvent {
  id             String          @id @default(uuid(7)) @db.Uuid
  provider       PaymentProvider
  eventId        String          @map("event_id")
  type           String
  signatureValid Boolean         @map("signature_valid")
  payload        Json
  status         WebhookStatus   @default(received)
  attempts       Int             @default(0)
  processedAt    DateTime?       @map("processed_at") @db.Timestamptz(3)
  error          String?
  receivedAt     DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("webhook_event")
}

model Refund {
  id                String       @id @default(uuid(7)) @db.Uuid
  refundNumber      String       @unique @default(dbgenerated("('RFD-'::text || lpad((nextval('refund_number_seq'::regclass))::text, 4, '0'::text))")) @map("refund_number")
  orderId           String       @map("order_id") @db.Uuid
  paymentId         String?      @map("payment_id") @db.Uuid
  requestedByUserId String?      @map("requested_by_user_id") @db.Uuid
  status            RefundStatus @default(requested)
  reason            String
  amountMinor       Int          @map("amount_minor")
  currency          CurrencyCode
  providerRefundRef String?      @unique @map("provider_refund_ref")
  decidedByAdminId  String?      @map("decided_by_admin_id") @db.Uuid
  decisionNote      String?      @map("decision_note")
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User?    @relation("RefundRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refund")
}

model Dispute {
  id                  String       @id @default(uuid(7)) @db.Uuid
  paymentId           String       @map("payment_id") @db.Uuid
  providerDisputeRef  String       @unique @map("provider_dispute_ref")
  status              String
  reason              String?
  amountMinor         Int          @map("amount_minor")
  currency            CurrencyCode
  dueBy               DateTime?    @map("due_by") @db.Timestamptz(3)
  evidenceSubmittedAt DateTime?    @map("evidence_submitted_at") @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("dispute")
}

model Invoice {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderId       String   @unique @map("order_id") @db.Uuid
  invoiceNumber String   @unique @default(dbgenerated("('INV-'::text || lpad((nextval('invoice_number_seq'::regclass))::text, 6, '0'::text))")) @map("invoice_number")
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  storageKey    String?  @map("storage_key")
  /// Seller and buyer details plus tax breakdown at issue time.
  legalSnapshot Json     @map("legal_snapshot")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("invoice")
}

model Coupon {
  id               String        @id @default(uuid(7)) @db.Uuid
  code             String        @unique @db.Citext
  description      String?
  type             CouponType
  /// Percent: whole percent (1–100). Fixed: minor units in `currency`.
  value            Int
  currency         CurrencyCode?
  minOrderMinor    Int?          @map("min_order_minor")
  maxDiscountMinor Int?          @map("max_discount_minor")
  usageLimit       Int?          @map("usage_limit")
  perCustomerLimit Int?          @map("per_customer_limit")
  startsAt         DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime?     @map("ends_at") @db.Timestamptz(3)
  isActive         Boolean       @default(true) @map("is_active")
  isStackable      Boolean       @default(false) @map("is_stackable")
  isPublic         Boolean       @default(false) @map("is_public")
  /// { scope: "all" } | { scope: "categories", ids: [...] } | { scope: "products", ids: [...] }
  appliesTo        Json          @default("{\"scope\":\"all\"}") @map("applies_to")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz(3)

  orders      Order[]
  redemptions CouponRedemption[]

  @@map("coupon")
}

/// Usage counts are derived from these rows; no stored counters.
model CouponRedemption {
  id          String   @id @default(uuid(7)) @db.Uuid
  couponId    String   @map("coupon_id") @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  guestEmail  String?  @map("guest_email") @db.Citext
  amountMinor Int      @map("amount_minor")
  redeemedAt  DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
  @@map("coupon_redemption")
}

model TaxRate {
  id        String    @id @default(uuid(7)) @db.Uuid
  country   String    @db.Char(2)
  region    String?
  label     String
  /// Basis points: 1800 = 18%.
  rateBps   Int       @map("rate_bps")
  inclusive Boolean   @default(true)
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(3)
  isActive  Boolean   @default(true) @map("is_active")

  @@index([country, isActive])
  @@map("tax_rate")
}

// ───────────────────────── Ownership & reading ─────────────────────────

model LibraryItem {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  source         LibrarySource
  orderItemId    String?       @map("order_item_id") @db.Uuid
  grantedAt      DateTime      @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(3)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)
  isFavorite     Boolean       @default(false) @map("is_favorite")
  ownedVersionId String?       @map("owned_version_id") @db.Uuid
  lastOpenedAt   DateTime?     @map("last_opened_at") @db.Timestamptz(3)

  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem      OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  ownedVersion   ProductVersion?  @relation(fields: [ownedVersionId], references: [id], onDelete: Restrict)
  progress       ReadingProgress?
  bookmarks      Bookmark[]
  downloadEvents DownloadEvent[]

  @@unique([userId, productId])
  @@index([userId, lastOpenedAt(sort: Desc)])
  @@map("library_item")
}

model ReadingProgress {
  id             String   @id @default(uuid(7)) @db.Uuid
  libraryItemId  String   @unique @map("library_item_id") @db.Uuid
  lastPage       Int      @map("last_page")
  totalPages     Int      @map("total_pages")
  lastChapterRef String?  @map("last_chapter_ref")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  libraryItem LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)

  @@map("reading_progress")
}

model Bookmark {
  id            String   @id @default(uuid(7)) @db.Uuid
  libraryItemId String   @map("library_item_id") @db.Uuid
  page          Int
  label         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  libraryItem LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)

  @@unique([libraryItemId, page])
  @@map("bookmark")
}

/// Download counts are derived from issued/completed rows.
model DownloadEvent {
  id               String         @id @default(uuid(7)) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  libraryItemId    String?        @map("library_item_id") @db.Uuid
  productVersionId String?        @map("product_version_id") @db.Uuid
  status           DownloadStatus
  reason           String?
  ip               String?
  userAgent        String?        @map("user_agent")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  libraryItem LibraryItem?    @relation(fields: [libraryItemId], references: [id], onDelete: Restrict)
  version     ProductVersion? @relation(fields: [productVersionId], references: [id], onDelete: Restrict)

  @@index([userId, libraryItemId, createdAt])
  @@map("download_event")
}

// ───────────────────────────── Engagement ─────────────────────────────

model WishlistItem {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("wishlist_item")
}

model RecentlyViewed {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, viewedAt(sort: Desc)])
  @@map("recently_viewed")
}

model Review {
  id                 String       @id @default(uuid(7)) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(pending)
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  moderatedById      String?      @map("moderated_by_id") @db.Uuid
  moderatedAt        DateTime?    @map("moderated_at") @db.Timestamptz(3)
  rejectionReason    String?      @map("rejection_reason")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  reports ReviewReport[]

  @@unique([userId, productId])
  @@index([productId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("review")
}

model ReviewReport {
  id         String   @id @default(uuid(7)) @db.Uuid
  reviewId   String   @map("review_id") @db.Uuid
  reportedBy String   @map("reported_by") @db.Uuid
  reason     String
  status     String   @default("open")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reportedBy])
  @@map("review_report")
}

// ─────────────────────────── Content & platform ───────────────────────────

model HomepageSection {
  id        String    @id @default(uuid(7)) @db.Uuid
  key       String    @unique
  type      String
  config    Json
  position  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, position])
  @@map("homepage_section")
}

model NavigationItem {
  id       String  @id @default(uuid(7)) @db.Uuid
  menu     String
  label    String
  href     String
  position Int     @default(0)
  parentId String? @map("parent_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")

  @@index([menu, position])
  @@map("navigation_item")
}

model NewsletterSubscriber {
  id             String           @id @default(uuid(7)) @db.Uuid
  email          String           @unique @db.Citext
  status         SubscriberStatus @default(pending)
  source         String?
  confirmedAt    DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  unsubscribedAt DateTime?        @map("unsubscribed_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("newsletter_subscriber")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notification")
}

model EmailLog {
  id                String   @id @default(uuid(7)) @db.Uuid
  toHash            String   @map("to_hash")
  template          String
  providerMessageId String?  @map("provider_message_id")
  status            String
  error             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([template, createdAt])
  @@map("email_log")
}

/// Search terms for Search Analytics (F3). No PII beyond the optional user id.
model SearchQuery {
  id           String   @id @default(uuid(7)) @db.Uuid
  term         String
  normalized   String
  resultsCount Int      @map("results_count")
  userId       String?  @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([normalized, createdAt])
  @@index([createdAt])
  @@map("search_query")
}

model Setting {
  key         String   @id
  value       Json
  isSecret    Boolean  @default(false) @map("is_secret")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("setting")
}
