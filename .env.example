# KRM.lib environment — placeholders only. Copy to .env.local for development.
# See docs/ENVIRONMENT.md. Never commit real values.

# ---- Public (safe for the browser) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Core ----
APP_ENV=development
DATABASE_URL=postgresql://krm:krm@localhost:5432/krm_lib
DIRECT_DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Auth & crypto ----
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=
DOWNLOAD_SIGNING_SECRET=
CRON_SECRET=

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Storage (local | r2) ----
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_PRIVATE=
STORAGE_BUCKET_PUBLIC=
CDN_BASE_URL=

# ---- Email (console | resend) ----
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=KRM.lib <noreply@krmlib.local>
EMAIL_REPLY_TO=

# ---- Jobs (Inngest) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Observability ----
ERROR_TRACKING_DSN=
LOG_LEVEL=info

# ---- Feature flags ----
FEATURE_CREATOR_SYSTEM=false
